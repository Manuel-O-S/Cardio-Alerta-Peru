# Copiar a backend/.env y completar. NUNCA subir el .env al repositorio.
#
# La cadena de conexión sale de Supabase:
#   Project Settings -> Database -> Connection string -> Session pooler
# Reemplazar [YOUR-PASSWORD] por la contraseña real.
#
# Si esta variable no está definida, el backend funciona igual usando
# backend/data/centros_referencia.json.

DATABASE_URL=postgresql://postgres.qxsymouhderflhqkicag:REEMPLAZAR@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Orígenes autorizados a llamar la API, separados por comas.
# En producción, la URL real de Netlify.
ORIGENES_PERMITIDOS=http://localhost:5173,https://chimerical-medovik-10895c.netlify.app
